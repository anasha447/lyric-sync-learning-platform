# Copy to .env to override the local defaults used by compose.yaml
POSTGRES_PASSWORD=local_dev_only
RABBITMQ_PASSWORD=local_dev_only
# Host port for Traefik; change it if 80 is taken
HTTP_PORT=80
POSTGRES_PORT=5432
# Backend image tag from GHCR (main, or sha-<short>)
BACKEND_TAG=main
# nlp-service image tag from GHCR, and its local port for /docs
NLP_TAG=main
NLP_PORT=8001
# Audio storage: "local" (default, files served under /media) or "r2" (Cloudflare R2)
STORAGE_TYPE=local
STORAGE_PUBLIC_BASE_URL=http://localhost/media
# For STORAGE_TYPE=r2: from Cloudflare dashboard > R2 > Manage API tokens (Object Read & Write, this bucket only)
# the bucket uses the EU jurisdiction, so its endpoint has .eu in it
R2_ENDPOINT=https://<account id>.eu.r2.cloudflarestorage.com
R2_BUCKET=lyricsync-audio
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
